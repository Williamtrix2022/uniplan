# Server
PORT=3000
NODE_ENV=development

# CORS: dominios permitidos separados por coma (ej. https://uniplan.app,https://www.uniplan.app)
# Si se deja vacío, se acepta cualquier origen (solo para desarrollo).
CORS_ORIGINS=

# Database
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Google Sign-In (Web Client ID de Google Cloud Console, usado como audience
# para verificar el idToken que manda la app móvil)
GOOGLE_CLIENT_ID=

# JWT
JWT_SECRET=
JWT_EXPIRE=7d
BCRYPT_ROUNDS=10
JWT_ACCESS_EXPIRE=30m
JWT_REFRESH_EXPIRE_DAYS=7

# Gmail SMTP (proveedor principal)
# 1. Activá verificación en 2 pasos en tu cuenta Google
# 2. Ir a: myaccount.google.com/apppasswords
# 3. Generá una App Password para 'Correo'
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=tu_correo@gmail.com

# Password Reset
RESET_PASSWORD_URL=uniplan://reset-password?
RESET_PASSWORD_WEB_URL=
RESET_TOKEN_EXPIRE_MINUTES=30